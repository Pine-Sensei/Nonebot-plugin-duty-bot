<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
html { font-size: {{ root_font_size | default(16) }}px; }
body { margin: 0; padding: 1.25rem; background: #edf2fa; font-family: "Microsoft YaHei", "Noto Sans CJK SC", "WenQuanYi Zen Hei", "PingFang SC", sans-serif; }
.card { background: #ffffff; border-radius: 0.875rem; padding: 1.5rem 1.75rem; }
.title { font-size: 1.25rem; font-weight: bold; color: #1f3a5f; border-left: 0.3rem solid #4a7ede; padding-left: 0.9rem; }
.subtitle { font-size: 0.85rem; color: #7c8aa5; margin-top: 0.35rem; padding-left: 1.2rem; }
table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; table-layout: fixed; }
th { background: #e8eefb; border: 0.0625rem solid #e4eaf5; padding: 0.65rem 0.35rem; text-align: center; font-weight: normal; }
th span { display: block; }
.label { font-size: 0.75rem; color: #7f8cab; }
.weekday { font-size: 0.9375rem; font-weight: bold; color: #33507a; white-space: nowrap; line-height: 1.3; }
.date { font-size: 0.75rem; color: #7f8cab; white-space: nowrap; margin-top: 0.1rem; line-height: 1.2; }
td { border: 0.0625rem solid #e4eaf5; padding: 0.65rem 0.35rem; text-align: center; line-height: 2.4375rem; }
tr.odd td { background: #f8fafd; }
td.empty { color: #b6c0d4; font-size: 0.875rem; }
.names { font-size: 0.875rem; font-weight: bold; color: #26375c; line-height: 2.4375rem; white-space: nowrap; }
.names.gap { margin-top: 0.3rem; }
th.time-col { background: #f2f6fd; }
.time-range { font-size: 0.8125rem; font-weight: bold; color: #46608c; line-height: 1.5; white-space: nowrap; }
.empty-tip { font-size: 0.875rem; color: #8a93a8; text-align: center; padding: 1.5rem 0; margin-top: 1rem; border: 0.0625rem dashed #e4eaf5; border-radius: 0.5rem; }
</style>
</head>
<body>
<div class="card">
  <div class="title">{{ view.title }}</div>
  <div class="subtitle">{{ view.date_range }}</div>
  {% if view.slot_times %}
  <table>
    <tr>
      <th><span class="label">时段</span></th>
      {% for h in view.headers %}<th><span class="weekday">{{ h.weekday }}</span><span class="date">{{ h.date_display }}</span></th>{% endfor %}
    </tr>
    {% for time in view.slot_times %}
    {% set row_cells = view.cells[loop.index0] %}
    <tr class="{{ loop.cycle('odd', 'even') }}">
      <th class="time-col"><div class="time-range">{{ time | replace("-", "<br />") | safe }}</div></th>
      {% for cell in row_cells %}
        {% if cell %}
        <td>
          {% for row in cell %}<div class="names{% if not loop.first %} gap{% endif %}">{{ row.primary }}</div>{% endfor %}
        </td>
        {% else %}
        <td class="empty">—</td>
        {% endif %}
      {% endfor %}
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <div class="empty-tip">本周无值班安排</div>
  {% endif %}
</div>
</body>
</html>
