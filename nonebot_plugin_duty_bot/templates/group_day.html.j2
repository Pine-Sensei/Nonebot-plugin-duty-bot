<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
html { font-size: {{ root_font_size | default(16) }}px; }
body { margin: 0; padding: 1.25rem; background: #eef1f7; font-family: "Microsoft YaHei", "Noto Sans CJK SC", "WenQuanYi Zen Hei", "PingFang SC", sans-serif; }
.card { background: #ffffff; border-radius: 0.75rem; padding: 1.375rem 1.625rem; }
.title { font-size: 1.25rem; font-weight: bold; color: #24335a; }
.subtitle { font-size: 0.875rem; color: #6b7690; margin-top: 0.25rem; }
table { width: 100%; border-collapse: collapse; margin-top: 0.875rem; }
th { background: #e8edf9; color: #46557e; font-size: 0.8125rem; padding: 0.5625rem 0.625rem; text-align: left; border-radius: 0.25rem; }
td { font-size: 0.8125rem; color: #333a4d; padding: 0.5625rem 0.625rem; border-bottom: 0.0625rem solid #edf0f6; }
tr.odd td { background: #f9fafe; }
.empty { font-size: 0.875rem; color: #8a93a8; text-align: center; padding: 1.125rem 0; }
</style>
</head>
<body>
<div class="card">
  <div class="title">{{ view.title }}</div>
  <div class="subtitle">{{ view.date_display }}</div>
  {% if view.rows %}
  <table>
    <tr><th>时间</th><th>岗位</th><th>主值</th><th>备值</th></tr>
    {% for row in view.rows %}
    <tr class="{{ loop.cycle('odd', 'even') }}">
      <td>{{ row.time_range }}</td>
      <td>{{ row.post_name }}</td>
      <td>{{ row.primary }}</td>
      <td>{{ row.backup }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <div class="empty">无值班安排</div>
  {% endif %}
</div>
</body>
</html>
